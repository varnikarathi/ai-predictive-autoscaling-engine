# Required. Replace both placeholders with private values before starting the server.
# Use a unique random secret of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars

# Use a private admin username and a bcrypt password hash. No default account exists.
ADMIN_USER=replace_with_private_admin_username
ADMIN_PASS_HASH=replace_with_bcrypt_hash

# Server port (default: 5000)
# PORT=5000

# Allowed browser origins, comma-separated.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Autoscaler poll interval in ms (default: 5000)
# POLL_INTERVAL_MS=5000

# Number of CPU data points to keep for ML models (default: 10)
# CPU_HISTORY_WINDOW=10

# Minimum data points before ML models start training (default: 6)
# MIN_TRAIN_SAMPLES=6

# Scaling thresholds
# SCALE_UP_THRESHOLD=70
# SCALE_DOWN_THRESHOLD=30
# MAX_INSTANCES=10
# MIN_INSTANCES=1
# COOLDOWN_MS=20000
# CONFIDENCE_THRESHOLD=0.6
